 }
 
+#if IS_ENABLED(CONFIG_RAW_HID)
+
+static ssize_t write_hids_raw_report(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                     const void *buf, uint16_t len, uint16_t offset,
+                                     uint8_t flags) {
+    const uint8_t *data = buf;
+    uint16_t taken = len;
+
+    ARG_UNUSED(conn);
+    ARG_UNUSED(attr);
+    ARG_UNUSED(flags);
+    if (offset != 0) {
+        return BT_GATT_ERR(BT_ATT_ERR_INVALID_OFFSET);
+    }
+    if (len > 0 && data == NULL) {
+        return BT_GATT_ERR(BT_ATT_ERR_INVALID_ATTRIBUTE_LEN);
+    }
+    if (len > 0 && data[0] == ZMK_HID_REPORT_ID_RAW) {
+        data++;
+        len--;
+    }
+    if (len > 0 && raw_hid_recv != NULL) {
+        raw_hid_recv(data, (uint8_t)MIN(len, UINT8_MAX));
+    }
+    return taken;
+}
+
+#endif // IS_ENABLED(CONFIG_RAW_HID)
+
 static ssize_t write_ctrl_point(struct bt_conn *conn, const struct bt_gatt_attr *attr,
                                 const void *buf, uint16_t len, uint16_t offset, uint8_t flags) {
     uint8_t *value = attr->user_data;
@@ -297,9 +383,74 @@ BT_GATT_SERVICE_DEFINE(
                        NULL, &led_indicators),
 #endif // IS_ENABLED(CONFIG_ZMK_HID_INDICATORS)
 
+#if IS_ENABLED(CONFIG_RAW_HID)
+    BT_GATT_CHARACTERISTIC(BT_UUID_HIDS_REPORT, BT_GATT_CHRC_READ | BT_GATT_CHRC_NOTIFY,
+                           BT_GATT_PERM_READ_ENCRYPT, NULL, NULL, NULL),
+    BT_GATT_CCC(NULL, BT_GATT_PERM_READ_ENCRYPT | BT_GATT_PERM_WRITE_ENCRYPT),
+    BT_GATT_DESCRIPTOR(BT_UUID_HIDS_REPORT_REF, BT_GATT_PERM_READ_ENCRYPT, read_hids_report_ref,
+                       NULL, &raw_hid_input),
+
+    BT_GATT_CHARACTERISTIC(BT_UUID_HIDS_REPORT,
+                           BT_GATT_CHRC_READ | BT_GATT_CHRC_WRITE | BT_GATT_CHRC_WRITE_WITHOUT_RESP,
+                           BT_GATT_PERM_READ_ENCRYPT | BT_GATT_PERM_WRITE_ENCRYPT, NULL,
+                           write_hids_raw_report, NULL),
+    BT_GATT_DESCRIPTOR(BT_UUID_HIDS_REPORT_REF, BT_GATT_PERM_READ_ENCRYPT, read_hids_report_ref,
+                       NULL, &raw_hid_output),
+#endif // IS_ENABLED(CONFIG_RAW_HID)
+
     BT_GATT_CHARACTERISTIC(BT_UUID_HIDS_CTRL_POINT, BT_GATT_CHRC_WRITE_WITHOUT_RESP,
                            BT_GATT_PERM_WRITE, NULL, write_ctrl_point, &ctrl_point));
 
+#if IS_ENABLED(CONFIG_RAW_HID)
+
+static int raw_hid_bind_notify_attr(void) {
+    const struct bt_gatt_attr *ref = &hog_svc.attrs[HOG_RAW_INPUT_REF_INDEX];
+
+    if (ref->user_data != &raw_hid_input) {
+        LOG_ERR("raw hid report ref is not at attr %u", HOG_RAW_INPUT_REF_INDEX);
+        return -EINVAL;
+    }
+    raw_hid_notify_attr = &hog_svc.attrs[HOG_RAW_INPUT_VALUE_INDEX];
+    return 0;
+}
+
+SYS_INIT(raw_hid_bind_notify_attr, APPLICATION, CONFIG_APPLICATION_INIT_PRIORITY);
+
+int zmk_hog_send_raw_report(const uint8_t *data, uint8_t len) {
+    struct bt_conn *conn = zmk_ble_active_profile_conn();
+    uint8_t report[CONFIG_RAW_HID_REPORT_SIZE] = {0};
+    int err;
+
+    if (conn == NULL) {
+        return -ENOTCONN;
+    }
+    if (data == NULL || raw_hid_notify_attr == NULL) {
+        bt_conn_unref(conn);
+        return data == NULL ? -EINVAL : -ENOENT;
+    }
+    if (len > CONFIG_RAW_HID_REPORT_SIZE) {
+        len = CONFIG_RAW_HID_REPORT_SIZE;
+    }
+    memcpy(report, data, len);
+
+    struct bt_gatt_notify_params notify_params = {
+        .attr = raw_hid_notify_attr,
+        .data = report,
+        .len = CONFIG_RAW_HID_REPORT_SIZE,
+    };
+
+    err = bt_gatt_notify_cb(conn, &notify_params);
+    if (err == -EPERM) {
+        bt_conn_set_security(conn, BT_SECURITY_L2);
+    } else if (err && err != -ENOTCONN) {
+        LOG_WRN("raw hid notify failed: %d", err);
+    }
+    bt_conn_unref(conn);
+    return err;
+}
+
+#endif // IS_ENABLED(CONFIG_RAW_HID)
+
